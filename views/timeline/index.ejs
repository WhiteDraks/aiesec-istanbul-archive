<%- include('../layout/header') %>

<style>
  /* Timeline Section Styles */
  .timeline-hero {
    padding: 5rem 0 3rem 0;
    text-align: center;
    background: radial-gradient(circle at center, rgba(3, 126, 243, 0.08) 0%, transparent 70%);
  }
  
  .timeline-hero h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #fff 0%, var(--primary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Yatay zaman şeridi: sayfaya sığar, yana kaydırılır */
  .hline-wrap { position: relative; }

  .hline-track {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    padding: 0.5rem 0 1.25rem;
    cursor: grab;
    scrollbar-width: thin;
  }
  .hline-track.dragging { cursor: grabbing; scroll-snap-type: none; user-select: none; }

  .hline-inner {
    position: relative;
    display: flex;
    gap: 1rem;
    width: max-content;
    min-width: 100%;
    padding: 0 1rem;
  }

  /* Yatay çizgi */
  .hline-inner::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 3.1rem;
    height: 3px;
    background: linear-gradient(to right, rgba(3, 126, 243, 0.1), var(--primary) 8%, var(--primary) 92%, rgba(3, 126, 243, 0.1));
    border-radius: 2px;
  }

  .hline-inner { align-items: flex-start; }
  .timeline-item {
    position: relative;
    flex: 0 0 15rem;
    scroll-snap-align: start;
    padding-top: 0;
  }

  .timeline-marker {
    position: relative;
    width: 18px;
    height: 18px;
    margin: 0.2rem 0 1.1rem 1.1rem;
    border-radius: 50%;
    background: var(--primary);
    border: 4px solid var(--background);
    box-shadow: 0 0 10px var(--primary);
    z-index: 2;
  }

  .timeline-year {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--primary);
    margin: 0 0 0.9rem;
    display: inline-block;
    padding: 0.15rem 0.7rem;
    border-radius: 20px;
    background: rgba(3, 126, 243, 0.08);
    border: 1px solid rgba(3, 126, 243, 0.15);
  }

  .timeline-card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1.1rem 1.2rem;
    border-radius: 14px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.12);
    transition: transform 0.25s ease, border-color 0.25s ease;
    min-height: 6rem;
  }
  .timeline-card:hover { transform: translateY(-3px); border-color: var(--primary); }

  .timeline-card h3 {
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.45;
    margin: 0;
    color: var(--text, #fff);
  }

  .timeline-card p {
    font-size: 0.9rem;
    color: var(--text-lighter);
    line-height: 1.55;
    margin: 0.6rem 0 0;
  }

  .timeline-image {
    width: 100%;
    max-height: 150px;
    object-fit: cover;
    border-radius: 10px;
    margin-top: 0.8rem;
    border: 1px solid var(--border);
  }

  .hline-nav { display: flex; justify-content: center; gap: 0.75rem; margin-top: 0.5rem; }
  .hline-hint { text-align: center; font-size: 0.85rem; color: var(--text-muted); margin: 0 0 0.5rem; }

  /* Fallback */
  .timeline-empty {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: 16px;
    max-width: 500px;
    margin: 2rem auto;
  }

  @media (max-width: 768px) {
    .timeline-item { flex-basis: 72vw; }
  }
</style>

<div class="timeline-hero">
  <div class="container">
    <h1>⏳ Tarih Şeridi</h1>
    <p style="color: var(--text-lighter); max-width: 600px; margin: 0 auto;">AIESEC İstanbul'un 1954'teki kuruluşundan bugüne uzanan ilham verici kilometre taşlarını ve başarı hikayelerini keşfedin.</p>
  </div>
</div>

<section class="section" style="padding-top: 1rem;">
  <div class="container">
    
    <% if (milestones.length === 0) { %>
      <div class="timeline-empty">
        <div style="font-size: 3rem; margin-bottom: 1rem;">⏳</div>
        <h3 style="color: #fff; margin-bottom: 0.5rem;">Zaman Tüneli Boş</h3>
        <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">Henüz sisteme bir kilometre taşı eklenmemiş. Yöneticiler tarafından yakında güncellenecektir.</p>
      </div>
    <% } else { %>
      <p class="hline-hint">Yana kaydırın ya da okları kullanın</p>
      <div class="hline-wrap">
        <div class="hline-track" tabindex="0" aria-label="Tarih şeridi">
          <div class="hline-inner">
            <% milestones.forEach((milestone) => { %>
              <div class="timeline-item">
                <span class="timeline-year"><%= milestone.year %></span>
                <div class="timeline-marker"></div>
                <div class="timeline-card">
                  <h3><%= milestone.title %></h3>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
        <div class="hline-nav">
          <button type="button" class="btn btn-outline btn-sm" data-timeline-scroll="-1" aria-label="Geri">‹ Geri</button>
          <button type="button" class="btn btn-outline btn-sm" data-timeline-scroll="1" aria-label="İleri">İleri ›</button>
        </div>
      </div>
    <% } %>

  </div>
</section>

<%- include('../layout/footer') %>
